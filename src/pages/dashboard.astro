---
export const prerender = false;

import DashboardBoard from "../components/dashboard/DashboardBoard";
import Layout from "../layouts/Layout.astro";
import { isAppNavActive } from "../lib/app-nav";
import {
  calendarHref,
  focusDate,
  monthGrid,
  weekGrid,
  parseCalendarOffset,
  parseCalendarRange,
  rangeCaption,
  weekdayLabels,
} from "../lib/calendar-range";
import { localDayKey, withCalendarSlots } from "../lib/current-task";
import { avatarLetter, loadSessionContext, navItemsForRole } from "../lib/household";

const { user, supabase } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/login?returnUrl=/dashboard");
}

const session = await loadSessionContext(supabase, user.id, user.email ?? null);
const learnerId = session.activeLearnerId;

type WeeklyStatus = "done" | "planned" | "upcoming";

interface WeeklyItem {
  id: string;
  title: string;
  module: string;
  dayKey: string;
  dayLabel: string;
  dateLabel: string;
  timeLabel: string;
  endLabel?: string;
  status: WeeklyStatus;
  href?: string;
  isMock?: boolean;
}

const now = new Date();
const calendarRange = parseCalendarRange(Astro.url.searchParams.get("range"));
const calendarOffset = parseCalendarOffset(Astro.url.searchParams.get("offset"), calendarRange);
const focus = focusDate(now, calendarRange, calendarOffset);
const caption = rangeCaption(calendarRange, focus);
const previousHref = calendarHref(calendarRange, calendarOffset - 1);
const nextHref = calendarHref(calendarRange, calendarOffset + 1);
const currentHref = calendarHref(calendarRange, 0);
const dayRangeHref = calendarHref("day", calendarRange === "day" ? calendarOffset : 0);
const weekRangeHref = calendarHref("week", calendarRange === "week" ? calendarOffset : 0);
const monthRangeHref = calendarHref("month", calendarRange === "month" ? calendarOffset : 0);

const weekDay = now.getDay();
const mondayOffset = weekDay === 0 ? -6 : 1 - weekDay;
const monday = new Date(now);
monday.setHours(12, 0, 0, 0);
monday.setDate(now.getDate() + mondayOffset);

const scheduleDates = Array.from({ length: 7 }).map((_, index) => {
  const date = new Date(monday);
  date.setDate(monday.getDate() + index);
  return date;
});

const todayKey = localDayKey(now);

let collectionsCount = 0;
let englishTotalDialogues = 0;
let englishCompletedDialogues = 0;
let recentEnglishAvg = 0;

let weeklyItems: WeeklyItem[] = [];

try {
  const [collectionsResponse, dialoguesResponse, progressResponse] = await Promise.all([
    supabase.from("collections").select("id", { count: "exact", head: true }).eq("user_id", learnerId),
    supabase
      .from("english_dialogues")
      .select("id, title, level, stage, lesson, estimated_duration_seconds, sort_order")
      .order("stage", { ascending: true })
      .order("lesson", { ascending: true })
      .order("sort_order", { ascending: true }),
    supabase
      .from("english_progress")
      .select("dialogue_id, score, completed_at")
      .eq("user_id", learnerId)
      .order("completed_at", { ascending: false }),
  ]);

  collectionsCount = collectionsResponse.count ?? 0;

  const dialogues = dialoguesResponse.data ?? [];
  const progress = progressResponse.data ?? [];

  englishTotalDialogues = dialogues.length;

  const bestScores = new Map<string, number>();
  for (const row of progress) {
    const prev = bestScores.get(row.dialogue_id) ?? -1;
    if (row.score > prev) {
      bestScores.set(row.dialogue_id, row.score);
    }
  }

  const completedDialogueIds = new Set<string>();
  for (const [dialogueId, score] of bestScores) {
    if (score >= 50) {
      completedDialogueIds.add(dialogueId);
    }
  }

  englishCompletedDialogues = completedDialogueIds.size;

  const recentScores = progress.slice(0, 10).map((row) => row.score);
  recentEnglishAvg =
    recentScores.length > 0
      ? Math.round(recentScores.reduce((sum, current) => sum + current, 0) / recentScores.length)
      : 0;

  const upcomingEnglish = dialogues.filter((dialogue) => !completedDialogueIds.has(dialogue.id)).slice(0, 8);

  const englishSlots = ["09:00", "10:00", "11:00", "13:00", "15:00"];

  const englishPlanItems: WeeklyItem[] = upcomingEnglish.map((dialogue, index) => {
    const dayIndex = index % 5;
    const date = scheduleDates[dayIndex];
    const dayKey = localDayKey(date);

    return {
      id: `english-${dialogue.id}`,
      title: `${dialogue.title}`,
      module: "English",
      dayKey,
      dayLabel: date.toLocaleDateString("pl-PL", { weekday: "short" }),
      dateLabel: date.toLocaleDateString("pl-PL", { day: "numeric", month: "short" }),
      timeLabel: englishSlots[index % englishSlots.length] ?? "09:00",
      status: "planned",
      href: `/english/lesson/${dialogue.level}/${dialogue.stage}/${dialogue.lesson}?dialogueId=${encodeURIComponent(dialogue.id)}`,
    };
  });

  const mockPlanItems: WeeklyItem[] = [
    {
      id: "mock-reading",
      title: "Czytanie ze zrozumieniem",
      module: "Język polski",
      dayKey: localDayKey(scheduleDates[1]),
      dayLabel: scheduleDates[1].toLocaleDateString("pl-PL", { weekday: "short" }),
      dateLabel: scheduleDates[1].toLocaleDateString("pl-PL", { day: "numeric", month: "short" }),
      timeLabel: "12:00",
      status: "upcoming",
      isMock: true,
    },
    {
      id: "mock-math",
      title: "Ułamki i procenty",
      module: "Matematyka",
      dayKey: localDayKey(scheduleDates[2]),
      dayLabel: scheduleDates[2].toLocaleDateString("pl-PL", { weekday: "short" }),
      dateLabel: scheduleDates[2].toLocaleDateString("pl-PL", { day: "numeric", month: "short" }),
      timeLabel: "14:00",
      status: "planned",
      isMock: true,
    },
    {
      id: "mock-science",
      title: "Przyroda: ekosystemy",
      module: "Przyroda",
      dayKey: localDayKey(scheduleDates[4]),
      dayLabel: scheduleDates[4].toLocaleDateString("pl-PL", { weekday: "short" }),
      dateLabel: scheduleDates[4].toLocaleDateString("pl-PL", { day: "numeric", month: "short" }),
      timeLabel: "16:00",
      status: "upcoming",
      isMock: true,
    },
  ];

  weeklyItems = withCalendarSlots([...englishPlanItems, ...mockPlanItems]);
} catch (_error) {
  collectionsCount = 0;
  englishTotalDialogues = 0;
  englishCompletedDialogues = 0;
  recentEnglishAvg = 0;
  weeklyItems = [];
}

const overallPlannedTopics = Math.max(englishTotalDialogues + 24, 40);
const overallCompletedTopics = Math.min(
  overallPlannedTopics,
  englishCompletedDialogues + Math.max(0, Math.round(collectionsCount * 1.5))
);
const overallPercent = overallPlannedTopics > 0 ? Math.round((overallCompletedTopics / overallPlannedTopics) * 100) : 0;
const englishPercent =
  englishTotalDialogues > 0 ? Math.round((englishCompletedDialogues / englishTotalDialogues) * 100) : 0;

const visibleDates =
  calendarRange === "month" ? monthGrid(focus) : calendarRange === "week" ? weekGrid(focus) : [focus];
const calendarDays = visibleDates.map((date) => {
  const dayKey = localDayKey(date);
  return {
    dayKey,
    dayLabel: date.toLocaleDateString("pl-PL", { weekday: "short" }),
    dateLabel: date.toLocaleDateString("pl-PL", { day: "numeric", month: "short" }),
    dayNumber: date.getDate(),
    isToday: dayKey === todayKey,
    inRange: calendarRange !== "month" || date.getMonth() === focus.getMonth(),
    items: weeklyItems.filter((item) => item.dayKey === dayKey).sort((a, b) => a.timeLabel.localeCompare(b.timeLabel)),
  };
});

const todayTasks = weeklyItems
  .filter((item) => item.dayKey === todayKey)
  .sort((a, b) => a.timeLabel.localeCompare(b.timeLabel));
const backlogTasks = weeklyItems.filter((item) => item.status === "upcoming").slice(0, 4);
const priorityTasks = weeklyItems.filter((item) => item.status === "planned" && item.dayKey !== todayKey).slice(0, 4);

const moduleCards = [
  {
    title: "English",
    subtitle: "Aktywny moduł",
    value: `${englishPercent}%`,
    href: "/english",
    color: "bg-emerald-50 text-emerald-700 border-emerald-200",
  },
  {
    title: "Matematyka",
    subtitle: "W przygotowaniu",
    value: "mock",
    href: "#",
    color: "bg-sky-50 text-sky-700 border-sky-200",
  },
  {
    title: "Język polski",
    subtitle: "W przygotowaniu",
    value: "mock",
    href: "#",
    color: "bg-rose-50 text-rose-700 border-rose-200",
  },
  {
    title: "Przyroda",
    subtitle: "W przygotowaniu",
    value: "mock",
    href: "#",
    color: "bg-amber-50 text-amber-700 border-amber-200",
  },
];

const mainNav = navItemsForRole(session.role).map((item) => ({
  ...item,
  isActive: isAppNavActive(item.href, Astro.url.pathname),
}));

const child = session.activeChild;
const childName = child?.displayName ?? null;
const childAge = child?.ageLabel ?? null;
const parentLabel =
  session.viewer.displayName !== "Bez imienia" ? session.viewer.displayName : (user.email ?? "Rodzic");
const showParentChip = session.isAdministrator;
const hasActiveChild = Boolean(child) || !session.isAdministrator;
---

<Layout title="Dashboard nauki | Flashcards Creator" hideHeader={true}>
  <div class="min-h-screen bg-gradient-to-b from-sky-50/60 via-white to-amber-50/40 text-slate-800">
    <div class="mx-auto flex w-full max-w-[1500px] gap-4 px-3 py-4 sm:px-5 sm:py-5">
      <aside
        class="hidden w-72 shrink-0 rounded-3xl border border-slate-200 bg-white/90 p-4 shadow-sm lg:flex lg:flex-col"
      >
        <a
          href="/dashboard"
          class="mb-5 block rounded-2xl border border-sky-100 bg-gradient-to-r from-sky-50 to-indigo-50 px-3 py-3 transition hover:shadow-sm"
        >
          <p class="text-lg font-bold text-slate-900">EduDom</p>
          <p class="text-xs text-slate-500">Nauka. Razem. Na całe życie.</p>
        </a>

        <nav class="space-y-1.5">
          {
            mainNav.map((item) => (
              <a
                href={item.href}
                class={`flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium transition ${
                  item.isActive
                    ? "bg-blue-50 text-blue-700 shadow-sm ring-1 ring-blue-100"
                    : "text-slate-600 hover:bg-slate-100 hover:text-slate-900"
                }`}
              >
                <span aria-hidden="true">{item.icon}</span>
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="mt-auto rounded-2xl border border-emerald-100 bg-emerald-50/70 p-3 text-xs text-emerald-800">
          Tryb ucznia aktywny. Funkcje administracyjne są dostępne z konta rodzica.
        </div>
      </aside>

      <main class="min-w-0 flex-1">
        <header class="mb-5 rounded-3xl border border-slate-200 bg-white/95 px-4 py-3 shadow-sm sm:px-5">
          <div class="flex flex-wrap items-center gap-3 xl:flex-nowrap">
            <div
              class="inline-flex min-w-[180px] items-center gap-2 rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-2"
            >
              {
                child?.avatarUrl ? (
                  <img src={child.avatarUrl} alt="" class="h-9 w-9 rounded-full object-cover ring-1 ring-slate-200" />
                ) : (
                  <div class="grid h-9 w-9 place-items-center rounded-full bg-white text-xs font-bold text-slate-600 ring-1 ring-slate-200">
                    {childName ? avatarLetter(childName) : "?"}
                  </div>
                )
              }
              <div class="leading-tight">
                <p class="text-sm font-semibold text-slate-900">{childName ?? "Brak dziecka"}</p>
                <p class="text-xs text-slate-500">
                  {[childAge, "uprawnienia: user"].filter(Boolean).join(" • ")}
                </p>
              </div>
            </div>

            <div class="flex grow items-center justify-center">
              <div class="flex flex-col items-center gap-2">
                <div
                  class="inline-flex rounded-full bg-slate-100 p-0.5 text-xs font-semibold"
                  role="group"
                  aria-label="Zakres kalendarza"
                >
                  <a
                    href={dayRangeHref}
                    class:list={[
                      "rounded-full px-3 py-1 transition",
                      calendarRange === "day"
                        ? "bg-white text-slate-900 shadow-sm"
                        : "text-slate-500 hover:text-slate-800",
                    ]}
                    aria-current={calendarRange === "day" ? "true" : undefined}
                  >
                    Dzień
                  </a>
                  <a
                    href={weekRangeHref}
                    class:list={[
                      "rounded-full px-3 py-1 transition",
                      calendarRange === "week"
                        ? "bg-white text-slate-900 shadow-sm"
                        : "text-slate-500 hover:text-slate-800",
                    ]}
                    aria-current={calendarRange === "week" ? "true" : undefined}
                  >
                    Tydzień
                  </a>
                  <a
                    href={monthRangeHref}
                    class:list={[
                      "rounded-full px-3 py-1 transition",
                      calendarRange === "month"
                        ? "bg-white text-slate-900 shadow-sm"
                        : "text-slate-500 hover:text-slate-800",
                    ]}
                    aria-current={calendarRange === "month" ? "true" : undefined}
                  >
                    Miesiąc
                  </a>
                </div>
                <div
                  class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-3 py-2 shadow-sm"
                >
                  <a
                    href={previousHref}
                    class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition hover:bg-slate-200"
                    aria-label={caption.previousLabel}
                  >
                    ←
                  </a>
                  <div class="min-w-[12rem] text-center">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">{caption.eyebrow}</p>
                    <p class="text-sm font-semibold text-slate-900">{caption.title}</p>
                  </div>
                  <a
                    href={nextHref}
                    class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition hover:bg-slate-200"
                    aria-label={caption.nextLabel}
                  >
                    →
                  </a>
                  {
                    calendarOffset !== 0 && (
                      <a
                        href={currentHref}
                        class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700 hover:bg-blue-100"
                      >
                        Dziś
                      </a>
                    )
                  }
                </div>
              </div>
            </div>

            <button
              type="button"
              disabled
              class="inline-flex min-w-[120px] items-center justify-center gap-1 rounded-2xl border border-amber-200 bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-800"
              title="Powiadomienia zostaną podłączone w kolejnej iteracji"
            >
              🔔 Powiadomienia
              <span class="rounded-full bg-rose-500 px-1.5 py-0.5 text-[10px] font-bold text-white">3</span>
            </button>

            {
              showParentChip && (
                <div class="inline-flex min-w-[220px] items-center gap-2 rounded-2xl border border-indigo-100 bg-indigo-50/80 px-3 py-2">
                  {session.viewer.avatarUrl ? (
                    <img
                      src={session.viewer.avatarUrl}
                      alt=""
                      class="h-9 w-9 rounded-full object-cover ring-1 ring-indigo-200"
                    />
                  ) : (
                    <div class="grid h-9 w-9 place-items-center rounded-full bg-white text-xs font-bold text-indigo-700 ring-1 ring-indigo-200">
                      {avatarLetter(parentLabel)}
                    </div>
                  )}
                  <div class="leading-tight">
                    <p class="text-sm font-semibold text-slate-900">Rodzic</p>
                    <p class="text-xs text-slate-500">uprawnienia: administrator</p>
                  </div>
                  <span class="ml-auto rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-semibold text-indigo-700">
                    {parentLabel}
                  </span>
                </div>
              )
            }
          </div>
        </header>

        <div
          class="mb-5 rounded-3xl border border-sky-100 bg-gradient-to-r from-white via-sky-50/70 to-emerald-50/60 p-5 shadow-sm sm:p-6"
        >
          <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div>
              <p
                class="inline-flex rounded-full bg-white/80 px-3 py-1 text-xs font-semibold text-slate-600 shadow-sm ring-1 ring-slate-200"
              >
                Dashboard nauki
              </p>
              <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
                {childName ? `Dobrego tygodnia, ${childName}!` : "Dodaj dziecko, aby zacząć"}
              </h1>
              <p class="mt-2 max-w-2xl text-sm text-slate-600 sm:text-base">
                {
                  hasActiveChild
                    ? "Kalendarz jest centrum panelu. English działa już produkcyjnie, kolejne moduły możesz dokładać stopniowo."
                    : "Rodzic zakłada konto dziecka w ustawieniach. Nowe konto od razu dostaje rolę użytkownika."
                }
              </p>
              {
                !hasActiveChild && (
                  <a
                    href="/settings"
                    class="mt-4 inline-flex rounded-full bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700"
                  >
                    Przejdź do ustawień
                  </a>
                )
              }
            </div>
          </div>
        </div>

        {
          hasActiveChild ? (
            <DashboardBoard
              client:load
              canManageLayout={session.isAdministrator}
              data={{
                calendar: {
                  range: calendarRange,
                  title: caption.title,
                  weekdayLabels,
                  days: calendarDays,
                },
                todayTasks,
                backlogTasks,
                priorityTasks,
                overallPercent,
                overallCompletedTopics,
                overallPlannedTopics,
                moduleCards,
                englishCompletedDialogues,
                englishTotalDialogues,
                recentEnglishAvg,
                collectionsCount,
              }}
            />
          ) : null
        }
      </main>
    </div>
  </div>
</Layout>
