---
export const prerender = false;

import AccountSwitcher from "../components/auth/AccountSwitcher";
import WidgetLibrary from "../components/dashboard/WidgetLibrary";
import Layout from "../layouts/Layout.astro";
import { isAppNavActive } from "../lib/app-nav";
import { avatarLetter, listHouseholdAccounts, loadSessionContext, navItemsForRole } from "../lib/household";

const { user, supabase } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/login?returnUrl=/widgets");
}

const session = await loadSessionContext(supabase, user.id, user.email ?? null);
const householdAccounts = await listHouseholdAccounts(supabase);

if (!session.isAdministrator) {
  return Astro.redirect("/dashboard");
}

const child = session.activeChild;
const childName = child?.displayName ?? "Brak dziecka";
const childAge = child?.ageLabel ?? null;
const parentLabel =
  session.viewer.displayName !== "Bez imienia" ? session.viewer.displayName : (user.email ?? "Rodzic");

const mainNav = navItemsForRole(session.role).map((item) => ({
  ...item,
  isActive: isAppNavActive(item.href, Astro.url.pathname),
}));
---

<Layout title="Biblioteka widgetów | Dashboard nauki" hideHeader={true}>
  <div class="min-h-screen bg-gradient-to-b from-sky-50/60 via-white to-amber-50/40 text-slate-800">
    <div class="mx-auto flex w-full max-w-[1500px] gap-4 px-3 py-4 sm:px-5 sm:py-5">
      <aside
        class="hidden w-72 shrink-0 rounded-3xl border border-slate-200 bg-white/90 p-4 shadow-sm lg:flex lg:flex-col"
      >
        <a
          href="/dashboard"
          class="mb-5 block rounded-2xl border border-sky-100 bg-gradient-to-r from-sky-50 to-indigo-50 px-3 py-3 transition hover:shadow-sm"
        >
          <p class="text-lg font-bold text-slate-900">EduDom</p>
          <p class="text-xs text-slate-500">Nauka. Razem. Na całe życie.</p>
        </a>

        <nav class="space-y-1.5">
          {
            mainNav.map((item) => (
              <a
                href={item.href}
                class={`flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium transition ${
                  item.isActive
                    ? "bg-blue-50 text-blue-700 shadow-sm ring-1 ring-blue-100"
                    : "text-slate-600 hover:bg-slate-100 hover:text-slate-900"
                }`}
              >
                <span aria-hidden="true">{item.icon}</span>
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="mt-auto rounded-2xl border border-emerald-100 bg-emerald-50/70 p-3 text-xs text-emerald-800">
          Katalog kafelków panelu. Nowy widget dopisuje się do rejestru, bez przebudowy dashboardu.
        </div>
      </aside>

      <main class="min-w-0 flex-1">
        <header class="mb-5 rounded-3xl border border-slate-200 bg-white/95 px-4 py-3 shadow-sm sm:px-5">
          <div class="flex flex-wrap items-center gap-3 xl:flex-nowrap">
            <div
              class="inline-flex min-w-[180px] items-center gap-2 rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-2"
            >
              {
                child?.avatarUrl ? (
                  <img src={child.avatarUrl} alt="" class="h-9 w-9 rounded-full object-cover ring-1 ring-slate-200" />
                ) : (
                  <div class="grid h-9 w-9 place-items-center rounded-full bg-white text-xs font-bold text-slate-600 ring-1 ring-slate-200">
                    {avatarLetter(childName)}
                  </div>
                )
              }
              <div class="leading-tight">
                <p class="text-sm font-semibold text-slate-900">{childName}</p>
                <p class="text-xs text-slate-500">{[childAge, "uprawnienia: user"].filter(Boolean).join(" • ")}</p>
              </div>
            </div>

            <div class="grow text-center">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Biblioteka</p>
              <p class="text-sm font-semibold text-slate-900">Widgety dostępne na panelu</p>
            </div>

            <button
              type="button"
              disabled
              class="inline-flex min-w-[120px] items-center justify-center gap-1 rounded-2xl border border-amber-200 bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-800"
            >
              🔔 Powiadomienia
              <span class="rounded-full bg-rose-500 px-1.5 py-0.5 text-[10px] font-bold text-white">3</span>
            </button>

            <AccountSwitcher client:load accounts={householdAccounts} currentUserId={user.id} />

            <div
              class="inline-flex min-w-[220px] items-center gap-2 rounded-2xl border border-indigo-100 bg-indigo-50/80 px-3 py-2"
            >
              {
                session.viewer.avatarUrl ? (
                  <img
                    src={session.viewer.avatarUrl}
                    alt=""
                    class="h-9 w-9 rounded-full object-cover ring-1 ring-indigo-200"
                  />
                ) : (
                  <div class="grid h-9 w-9 place-items-center rounded-full bg-white text-xs font-bold text-indigo-700 ring-1 ring-indigo-200">
                    {avatarLetter(parentLabel)}
                  </div>
                )
              }
              <div class="leading-tight">
                <p class="text-sm font-semibold text-slate-900">Rodzic</p>
                <p class="text-xs text-slate-500">uprawnienia: administrator</p>
              </div>
              <span class="ml-auto rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-semibold text-indigo-700">
                {parentLabel}
              </span>
            </div>
          </div>
        </header>

        <div
          class="rounded-3xl border border-sky-100 bg-gradient-to-r from-white via-sky-50/70 to-emerald-50/60 p-5 shadow-sm sm:p-6"
        >
          <p
            class="inline-flex rounded-full bg-white/80 px-3 py-1 text-xs font-semibold text-slate-600 shadow-sm ring-1 ring-slate-200"
          >
            Biblioteka widgetów
          </p>
          <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">Dostępne widgety</h1>
          <p class="mt-2 max-w-2xl text-sm text-slate-600 sm:text-base">
            Dodajesz i usuwasz widgety z panelu. Układ zapisuje się w tej przeglądarce. Na panelu widgety przeciągasz
            między stałymi miejscami.
          </p>
          <div class="mt-5">
            <WidgetLibrary client:load />
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>
